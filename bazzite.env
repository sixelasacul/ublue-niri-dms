# output image name, usually same as repo name, change as needed
IMAGE_NAME="bazzite-niri-dms"

# Make this the same as your github username/organisation
REPO_ORGANIZATION="sixelasacul"

IMAGE_DESC="Bazzite but with Niri and DankMaterialShell for the DE"
