# Here we set a bunch of parameters for your image build

BASE_IMAGE="ghcr.io/ublue-os/bazzite-nvidia-open:stable"

# output image name, usually same as repo name, change as needed
IMAGE_NAME="bazzite-nvidia-niri-dms"

# Make this the same as your github username/organisation
REPO_ORGANIZATION="sixelasacul"

IMAGE_DESC="Bazzite but with Niri and DankMaterialShell for the DE"
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,nvidia,fedora,atomic,niri,dms"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/19547331?s=400&u=d708e2ae7af8703488a8ff6e0f4cef546b2dd023&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
